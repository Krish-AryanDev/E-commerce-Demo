# ----------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in the values from your
# project dashboard (Project Settings → API).
# ----------------------------------------------------------------------------

# Public — safe to expose to the browser (used by the browser + server clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server only. NEVER expose this to the client.
# Used by the seed script and privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
